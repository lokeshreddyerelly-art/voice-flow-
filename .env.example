# VoiceFlow Agents Environment Configuration Example

# Database (SQLite file or PostgreSQL URL)
DATABASE_URL="file:./dev.db"

# Lyzr Studio Integration (Server-side only)
LYZR_API_KEY="sk-default-YOUR_KEY_HERE"
LYZR_AGENT_ID="6ace4559e2a5d9a7e5074970"
LYZR_USER_ID="user@example.com"
LYZR_SESSION_ID="session-id-here"
LYZR_ENDPOINT="https://agent-prod.studio.lyzr.ai/v3/inference/chat/"

# Provider Mode: "lyzr" | "mock" | "auto"
AI_PROVIDER="auto"

# Default User
DEFAULT_USER_EMAIL="user@example.com"
DEFAULT_USER_NAME="Workflow User"

# Execution Bounds
MAX_PARALLEL_TASKS=3
TASK_TIMEOUT_MS=60000
MAX_TASK_RETRIES=3
